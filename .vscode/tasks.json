{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Sign bin",
            "command": "python",          
            "args": [
                "C:/ncs/v2.7.0/bootloader/mcuboot/scripts/imgtool.py",
                "sign",
                //"--key", "${workspaceFolder}/priv.pem",
                "--header-size","0x200",
                "--pad",
                "--pad-header",
                "--slot-size","0xE8000",
                "--align","4",
                //"--pad",
                //"--pad-sig",
                "--version","${input:version}",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/zephyr.signed.bin",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/signed.bin",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Generated task for padding the signed binary"
        },
        {
            "type": "process",
            "label": "Verify bin",
            "command": "python",          
            "args": [
                "C:/ncs/v2.7.0/bootloader/mcuboot/scripts/imgtool.py",
                "verify",
                "--key", "${workspaceFolder}/priv.pem",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/signed.bin"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Generated task for verify the signed binary"
        }
    ],
    "inputs": [
        {
            "id": "version",
            "type": "promptString",
            "description": "Enter the version",
            "default": "1.0.0"
        }
    ]

}