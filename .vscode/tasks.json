{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Run imgtool.py script",
            "command": "python",          
            "args": [
                "C:/ncs/v2.7.0/bootloader/mcuboot/scripts/imgtool.py",
                "sign",
                "--header-size","0x200",
                "--pad-header",
                "--slot-size","0xE8000",
                "--align","4",
                "--pad",
                "--pad-sig",
                "--version","${input:version}",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/zephyr.signed.bin",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/signed.bin"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Generated task for padding the signed binary"
        },
        {
            "type": "process",
            "label": "Flash signed image with nrfjprog",
            "command": "nrfjprog",
            "args": [
                "--program",
                "${workspaceFolder}/build/modem_and_sensor/zephyr/signed.bin",
                "--sectorerase",
                "--verify",
                "--startaddress", "0x10000"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "Task to flash the signed and padded image on primary using nrfjprog"
        }
    ],
    "inputs": [
        {
            "id": "version",
            "type": "promptString",
            "description": "Enter the version",
            "default": "1.0.0"
        }
    ]

}