{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${nrf-connect.sdk:2.7.0}/zephyr/include",
                "${nrf-connect.sdk:2.7.0}/zephyr/include/zephyr",
                "${nrf-connect.sdk:2.7.0}/nrfxlib",
                "${nrf-connect.sdk:2.7.0}/zephyr/include/zephyr/drivers",
                "${nrf-connect.sdk:2.7.0}/zephyr/include/zephyr/kernel",
                "${nrf-connect.sdk:2.7.0}/zephyr/include/zephyr/usb",
                "${nrf-connect.sdk:2.7.0}/zephyr/arch",             
                "${nrf-connect.sdk:2.7.0}/nrfxlib/nrf_modem/include",
                "${nrf-connect.sdk:2.7.0}/nrf/include",
                "${nrf-connect.sdk:2.7.0}/nrf/include/modem",
                "${nrf-connect.sdk:2.7.0}/zephyr/drivers",
                "${nrf-connect.sdk:2.7.0}/zephyr/kernel",
                "${nrf-connect.sdk:2.7.0}/modules/lib/cjson"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000",
                "ARCH_STACK_PTR_ALIGN=4"
            ],
            "configurationProvider": "nordic-semiconductor.nrf-connect",
            "compilerPath": "${nrf-connect.toolchain:2.7.0}/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc.exe",
            "cppStandard": "gnu++11",
            "cStandard": "gnu11"
        }
    ],
    "version": 4
}