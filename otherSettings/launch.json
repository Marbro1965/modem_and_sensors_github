{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with JLink",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "TM4C1290NCPDT",
            "interface": "jtag",    
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "cwd": "${workspaceFolder}",
            "serverpath": "C:/Program Files/SEGGER/JLink_V810a/JLinkGDBServerCL.exe",
            "executable": "./out/HT1000I/Versione6/HT1000I.axf",
        },
        {
            "cwd": "${workspaceRoot}",
            "executable": "./out/HT1000I/Versione6/HT1000I.axf",
            "name": "Debug with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "device": "TM4C1290NCPDT",
            "interface": "jtag"
        },
        {
            "name": "Arm Debugger",
            "type": "arm-debugger",
            "request": "launch",
            "serialNumber": "${command:device-manager.getSerialNumber}",
            "programs": "${command:cmsis-csolution.getBinaryFiles}",
            "cmsisPack": "${command:cmsis-csolution.getTargetPack}",
            "deviceName": "${command:cmsis-csolution.getDeviceName}",
            "processorName": "${command:cmsis-csolution.getProcessorName}"
        }
    ]
}
